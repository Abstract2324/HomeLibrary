
Процедура ПриНачалеРаботыСистемы()
	Время = ""; 
	Утро = НачалоДня(ТекущаяДата()) + 3600*12;
	День = НачалоДня(ТекущаяДата()) + 3600*18; 
	Вечер = НачалоДня(ТекущаяДата()) + 3600*23;
	Если ТекущаяДата() < Утро Тогда
		Время = "Доброе утро";
	ИначеЕсли ТекущаяДата() < День Тогда
		Время = "Добрый день";
	ИначеЕсли ТекущаяДата() < Вечер Тогда
		Время = "Добрый вечер";
	КонецЕсли;
	
	Сообщить(Время + ", мам!"); 
	
КонецПроцедуры
