
&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	КИзменению = Объект.Наименование;
	МассивСлов = СтрРазделить(КИзменению, " ");
	МассивСлов[0] = ТРег(МассивСлов[0]);
	Объект.Наименование = "";
	КИзменению = "";
	Для каждого Слово Из МассивСлов Цикл
		КИЗменению = КИзменению + " " + Слово;
	КонецЦикла;	
	Объект.Наименование = СокрЛП(КИзменению);

КонецПроцедуры
